{
  "name": "pui-literasi-seni-unimed",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Website PUI Literasi dan Seni dalam Pendidikan, Universitas Negeri Medan",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "images": "node scripts/optimize-images.mjs",
    "audit": "npx --yes lighthouse http://localhost:4173 --preset=desktop --only-categories=performance,accessibility,best-practices,seo,pwa --output=html --output-path=./lighthouse-desktop.html --chrome-flags=\"--headless=new\"",
    "audit:mobile": "npx --yes lighthouse http://localhost:4173 --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=./lighthouse-mobile.html --chrome-flags=\"--headless=new\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
