# Pengembangan lokal: `cp .env.example .env` lalu `npm run dev` (Node 20.6+).
# Produksi: jangan pakai file ini. Isi lewat Cloud Run (env var dan Secret Manager), lihat deploy/deploy.sh.

NODE_ENV=development
PORT=8080

# memory | firestore
STORE=memory
# Muat data contoh ke memori saat start (hanya STORE=memory)
SEED=1
FIRESTORE_DATABASE_ID=(default)

# WAJIB, minimal 32 karakter acak. Dipakai menandatangani token sesi. Mengganti nilainya memutus semua sesi.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter-xxxxxxxx
SESSION_TTL_HOURS=12

# Admin pertama. Hanya dibuat bila BELUM ADA admin sama sekali. Wajib ganti kata sandi saat login pertama.
# Setelah admin pertama dibuat, hapus BOOTSTRAP_* dari konfigurasi.
BOOTSTRAP_ADMIN_EMAIL=admin@pui.local
BOOTSTRAP_ADMIN_PASSWORD=Sementara12345
BOOTSTRAP_ADMIN_NAME=Admin PUI

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173

# Cloud Storage untuk unggah PDF dan gambar
GCS_BUCKET=
# Kosongkan untuk memakai https://storage.googleapis.com/<bucket>; isi bila memakai CDN atau domain sendiri
PUBLIC_FILES_BASE_URL=

APP_TIME_ZONE=Asia/Jakarta
CACHE_TTL_MS=30000
MAX_UPLOAD_BYTES=20971520
REGISTRATION_MAX_PER_HOUR=5
LOGIN_MAX_FAILURES=8
# Biaya scrypt (pangkat dua, minimal 1024). Jangan diturunkan di produksi.
SCRYPT_N=16384
